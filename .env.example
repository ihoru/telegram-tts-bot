# Copy to .env for local use. The application reads process environment only;
# source the file explicitly or pass it to Docker with --env-file.

# Required only by the Telegram bot. Never commit a real token.
TELEGRAM_BOT_TOKEN=replace-with-botfather-token

# Optional local overrides. Leave commented for the documented local defaults and
# for the model baked into the production image.
# PIPER_MODEL_PATH=.models/piper/ru_RU-denis-medium.onnx
# PIPER_CONFIG_PATH=.models/piper/ru_RU-denis-medium.onnx.json

TTS_MAX_CONCURRENCY=5
TTS_MAX_CONCURRENCY_PER_USER=1
LOG_LEVEL=INFO
