# Copy to .env for local use. The application reads process environment only;
# source the file explicitly or pass it to Docker with --env-file.

# Required only by the Telegram bot. Never commit a real token.
TELEGRAM_BOT_TOKEN=replace-with-botfather-token

# Optional local overrides. Aiden is the default; Serena uses the same Qwen snapshot.
# The runtime image expects Qwen at /models/qwen3-tts-12hz-0.6b-customvoice and bakes
# Silero at /opt/silero/v5_5_ru.pt.
# QWEN_MODEL_PATH=.models/qwen3-tts-12hz-0.6b-customvoice
# SILERO_MODEL_PATH=.models/silero/v5_5_ru.pt
# TTS_VOICE=aiden  # aiden, serena, kseniya, xenia, or baya

TTS_MAX_CONCURRENCY=1
TTS_MAX_CONCURRENCY_PER_USER=1
TTS_MAX_QUEUE_SIZE=20
TTS_MAX_QUEUE_SIZE_PER_USER=10
TTS_MAX_QUEUE_WAIT_SECONDS=600
LOG_LEVEL=INFO
